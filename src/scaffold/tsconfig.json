{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["parts/**/*.ts", "helpers/**/*.ts", "*.ts"],
  "exclude": ["node_modules"]
}
